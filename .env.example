# Copy to .env in the project folder (never commit .env) and fill in only what you use.
# The app reads these from the environment or from .env in the directory you run "automation" from.
# Empty values count as unset.

# Which config file to load (default: config.toml in the working directory).
AUTOMATION_CONFIG=

# Optional overrides of config values: AUTOMATION_<SECTION>__<KEY>, for example:
AUTOMATION_LOG__LEVEL=
AUTOMATION_LOG__FORMAT=
AUTOMATION_STATE__PATH=

# Secrets. Only ever here or in the environment, never in config.toml.
# Slack incoming webhook URL (Slack app > Incoming Webhooks > Add New Webhook).
SLACK_WEBHOOK_URL=
# Password for [notify.email] username.
SMTP_PASSWORD=
# GitHub token for github-weekly (needed for private repositories and higher rate limits).
GITHUB_TOKEN=
# Optional summaries ([llm] provider = "anthropic" or "openai").
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
